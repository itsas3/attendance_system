generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NoteVisibility {
  PUBLIC
  PRIVATE
}

enum AccrualFrequency {
  MONTHLY
  ANNUALLY
}

enum LeaveRequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum UserAccountStatus {
  PENDING
  ACTIVE
  LOCKED
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ENDED
}

enum EmploymentStatus {
  PENDING
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
  ENDED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PART_TIME
  INTERN
  CONSULTANT
}

enum AssignmentType {
  PRIMARY
  SECONDARY
  ACTING
  TEMPORARY
}

enum OrganizationUnitType {
  COMPANY
  DIVISION
  DEPARTMENT
  TEAM
  BRANCH
  COST_CENTER
}

enum ReportingLineType {
  PRIMARY
  FUNCTIONAL
  PROJECT
}

enum RoleAssignmentSource {
  SYSTEM
  POSITION
  MANUAL
  TEMPORARY
}

enum PermissionScope {
  SELF
  DIRECT_REPORTS
  REPORTING_TREE
  ORGANIZATION_UNIT
  ORGANIZATION_UNIT_TREE
  ORGANIZATION
}

enum DeviceStatus {
  ACTIVE
  DISABLED
  OFFLINE
}

enum DeviceMode {
  SCAN
  ENROLL
}

enum EnrollmentSessionStatus {
  PENDING
  CLAIMED
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum FingerprintEnrollmentStatus {
  ACTIVE
  REVOKED
}

enum ManualAttendanceRequestType {
  ADD_SCAN
  REMOVE_SCAN
}

enum ManualAttendanceRequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApproverKind {
  MANAGER
  HR
  OWNER
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationType {
  APPROVAL_REQUESTED
  APPROVAL_REMINDER
  ATTENDANCE_ANOMALY
  DEVICE_OFFLINE
  ENROLLMENT_FAILED
  REPORT_READY
}

enum ReportExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum JobPostingStatus {
  OPEN
  CLOSED
}

model Person {
  id                    String                   @id @default(cuid())
  legalName             String
  preferredName         String?
  personalEmail         String?
  phone                 String?
  dateOfBirth           DateTime?                @db.Date
  gender                String?
  maritalStatus         String?
  currentAddress        String?
  permanentAddress      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  userAccount           UserAccount?
  memberships           OrganizationMembership[]
}

model UserAccount {
  id                     String                    @id @default(cuid())
  personId               String                    @unique
  loginEmail             String                    @unique
  passwordHash           String?
  status                 UserAccountStatus         @default(PENDING)
  emailVerifiedAt        DateTime?
  lastLoginAt            DateTime?
  authVersion            Int                       @default(1)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  person                 Person                    @relation(fields: [personId], references: [id], onDelete: Restrict)
  sessions               UserSession[]
  createdManualRequests  ManualAttendanceRequest[] @relation("ManualRequestCreatedBy")
  requestedEnrollments   EnrollmentSession[]       @relation("EnrollmentRequestedBy")
  notifications          Notification[]
  auditLogs              AuditLog[]                @relation("AuditLogActor")
  reportExports          ReportExport[]
  createdJobPostings     JobPosting[]              @relation("JobPostingCreatedBy")
  createdAnnouncements   Announcement[]            @relation("AnnouncementCreatedBy")
  createdTemplates       PerformanceTemplate[]     @relation("PerformanceTemplateCreator")
  grantedRoleAssignments RoleAssignment[]          @relation("RoleAssignmentGrantedBy")

  @@index([status])
}

model UserSession {
  id            String      @id @default(cuid())
  userAccountId String
  tokenHash     String      @unique
  authVersion   Int
  expiresAt     DateTime
  revokedAt     DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime    @default(now())
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@index([userAccountId, expiresAt])
}

model Organization {
  id                   String                   @id @default(cuid())
  name                 String
  slug                 String                   @unique
  timezone             String                   @default("Asia/Karachi")
  isActive             Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  memberships          OrganizationMembership[]
  employments          Employment[]
  units                OrganizationUnit[]
  positions            Position[]
  roles                Role[]
  devices              Device[]
  scanEvents           ScanEvent[]
  shifts               Shift[]
  holidays             Holiday[]
  companySettings      CompanySetting[]
  jobPostings          JobPosting[]
  announcements        Announcement[]
  leaveTypeConfigs     LeaveTypeConfig[]
  performanceTemplates PerformanceTemplate[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  reportExports        ReportExport[]
}

model OrganizationMembership {
  id              String           @id @default(cuid())
  organizationId  String
  personId        String
  status          MembershipStatus @default(INVITED)
  joinedAt        DateTime?
  endedAt         DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person          Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  employments     Employment[]
  roleAssignments RoleAssignment[]

  @@unique([organizationId, personId])
  @@unique([id, organizationId])
  @@index([personId, status])
  @@index([organizationId, status])
}

model Employment {
  id                        String                    @id @default(cuid())
  organizationId            String
  membershipId              String
  employeeCode              String?
  status                    EmploymentStatus          @default(PENDING)
  type                      EmploymentType            @default(PERMANENT)
  hiredAt                   DateTime                  @default(now()) @db.Date
  probationEnd              DateTime?                 @db.Date
  endedAt                   DateTime?                 @db.Date
  attendanceEligible        Boolean                   @default(true)
  leaveEligible             Boolean                   @default(true)
  lastAnnouncementsViewedAt DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership                OrganizationMembership    @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignments               EmploymentAssignment[]
  subordinateLines          ReportingLine[]           @relation("ReportingLineSubordinate")
  supervisorLines           ReportingLine[]           @relation("ReportingLineSupervisor")
  approvalSteps             ApprovalStep[]            @relation("ApprovalStepApprover")
  fingerprintRecords        FingerprintEnrollment[]
  enrollmentSessions        EnrollmentSession[]
  manualRequests            ManualAttendanceRequest[] @relation("ManualRequestEmployee")
  scanEvents                ScanEvent[]
  shiftAssignments          ShiftAssignment[]
  interviewStepAssignments  JobPostingStep[]          @relation("InterviewStepInterviewer")
  leaveRequests             LeaveRequest[]            @relation("LeaveRequestEmployee")
  leaveApprovalSteps        LeaveApprovalStep[]       @relation("LeaveApprovalStepApprover")
  leaveBalances             LeaveBalance[]
  targetNotes               EmployeeNote[]            @relation("NoteTargetEmployee")
  authoredNotes             EmployeeNote[]            @relation("NoteAuthor")
  receivedEvaluations       PerformanceEvaluation[]   @relation("PerformanceTargetEmployee")
  submittedEvaluations      PerformanceEvaluation[]   @relation("PerformanceEvaluator")

  @@unique([organizationId, employeeCode])
  @@index([membershipId, status])
  @@index([organizationId, status])
}

model OrganizationUnit {
  id                    String                 @id @default(cuid())
  organizationId        String
  parentId              String?
  code                  String?
  name                  String
  type                  OrganizationUnitType
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent                OrganizationUnit?      @relation("OrganizationUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children              OrganizationUnit[]     @relation("OrganizationUnitHierarchy")
  employmentAssignments EmploymentAssignment[]
  scopedRoleAssignments RoleAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
}

model Position {
  id                    String                 @id @default(cuid())
  organizationId        String
  code                  String?
  title                 String
  description           String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employmentAssignments EmploymentAssignment[]
  defaultRoleMappings   PositionRoleMapping[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model EmploymentAssignment {
  id                 String           @id @default(cuid())
  employmentId       String
  organizationUnitId String
  positionId         String
  type               AssignmentType   @default(PRIMARY)
  validFrom          DateTime         @db.Date
  validUntil         DateTime?        @db.Date
  workLocation       String?
  timezone           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  employment         Employment       @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  position           Position         @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([employmentId, validFrom, validUntil])
  @@index([organizationUnitId, validFrom, validUntil])
  @@index([positionId, validFrom, validUntil])
}

model ReportingLine {
  id                      String            @id @default(cuid())
  subordinateEmploymentId String
  supervisorEmploymentId  String
  type                    ReportingLineType @default(PRIMARY)
  validFrom               DateTime          @db.Date
  validUntil              DateTime?         @db.Date
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  subordinate             Employment        @relation("ReportingLineSubordinate", fields: [subordinateEmploymentId], references: [id], onDelete: Restrict)
  supervisor              Employment        @relation("ReportingLineSupervisor", fields: [supervisorEmploymentId], references: [id], onDelete: Restrict)

  @@index([subordinateEmploymentId, validFrom, validUntil])
  @@index([supervisorEmploymentId, validFrom, validUntil])
}

model Device {
  id                     String                  @id @default(cuid())
  organizationId         String?
  name                   String
  location               String?
  apiKeyHash             String
  status                 DeviceStatus            @default(ACTIVE)
  reportedMode           DeviceMode              @default(SCAN)
  modeChangedAt          DateTime                @default(now())
  firmwareVersion        String?
  lastSeenAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  enrollmentSessions     EnrollmentSession[]
  fingerprintEnrollments FingerprintEnrollment[]
  scanEvents             ScanEvent[]

  @@index([status, lastSeenAt])
  @@index([organizationId, status])
}

model FingerprintEnrollment {
  id                String                      @id @default(cuid())
  employeeId        String
  deviceId          String
  scannerTemplateId Int
  status            FingerprintEnrollmentStatus @default(ACTIVE)
  enrolledAt        DateTime                    @default(now())
  revokedAt         DateTime?
  device            Device                      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee          Employment                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([deviceId, scannerTemplateId])
  @@unique([employeeId, deviceId])
}

model EnrollmentSession {
  id                       String                  @id @default(cuid())
  employeeId               String
  deviceId                 String
  requestedByUserAccountId String
  scannerTemplateId        Int?
  status                   EnrollmentSessionStatus @default(PENDING)
  errorMessage             String?
  expiresAt                DateTime
  claimedAt                DateTime?
  completedAt              DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  device                   Device                  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee                 Employment              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  requestedBy              UserAccount             @relation("EnrollmentRequestedBy", fields: [requestedByUserAccountId], references: [id], onDelete: Restrict)

  @@index([deviceId, status, expiresAt])
  @@index([employeeId, status])
}

model ScanEvent {
  id                 String                    @id @default(cuid())
  organizationId     String?
  deviceId           String
  employeeId         String?
  scannerTemplateId  Int
  deviceScanSequence Int?
  firmwareVersion    String?
  matchConfidence    Decimal?                  @db.Decimal(5, 4)
  rawPayload         Json?
  serverReceivedAt   DateTime                  @default(now())
  createdAt          DateTime                  @default(now())
  removedByRequests  ManualAttendanceRequest[] @relation("RemovedScan")
  organization       Organization?             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  device             Device                    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee           Employment?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([deviceId, deviceScanSequence])
  @@index([employeeId, serverReceivedAt])
  @@index([deviceId, serverReceivedAt])
  @@index([organizationId, serverReceivedAt])
}

model Shift {
  id             String            @id @default(cuid())
  organizationId String?
  name           String
  timezone       String            @default("Asia/Karachi")
  startTime      String
  endTime        String
  workdays       Int[]
  graceMinutes   Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments    ShiftAssignment[]

  @@index([organizationId])
}

model ShiftAssignment {
  id            String     @id @default(cuid())
  employeeId    String
  shiftId       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime   @default(now())
  employee      Employment @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shift         Shift      @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom, effectiveTo])
}

model ManualAttendanceRequest {
  id                     String                        @id @default(cuid())
  employeeId             String
  createdByUserAccountId String
  type                   ManualAttendanceRequestType
  requestedTimestamp     DateTime?
  targetScanEventId      String?
  reason                 String
  status                 ManualAttendanceRequestStatus @default(PENDING_MANAGER)
  appliedAt              DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  approvalSteps          ApprovalStep[]
  createdBy              UserAccount                   @relation("ManualRequestCreatedBy", fields: [createdByUserAccountId], references: [id], onDelete: Restrict)
  employee               Employment                    @relation("ManualRequestEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  targetScanEvent        ScanEvent?                    @relation("RemovedScan", fields: [targetScanEventId], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  @@index([status, createdAt])
}

model ApprovalStep {
  id                        String                  @id @default(cuid())
  manualAttendanceRequestId String
  sequence                  Int
  approverEmployeeId        String
  approverKind              ApproverKind
  status                    ApprovalStatus          @default(PENDING)
  comment                   String?
  decidedAt                 DateTime?
  createdAt                 DateTime                @default(now())
  approver                  Employment              @relation("ApprovalStepApprover", fields: [approverEmployeeId], references: [id], onDelete: Restrict)
  manualAttendanceRequest   ManualAttendanceRequest @relation(fields: [manualAttendanceRequestId], references: [id], onDelete: Cascade)

  @@unique([manualAttendanceRequestId, sequence])
  @@index([approverEmployeeId, status])
}

model Notification {
  id             String             @id @default(cuid())
  organizationId String?
  userAccountId  String
  type           NotificationType
  status         NotificationStatus @default(UNREAD)
  title          String
  body           String
  payload        Json?
  readAt         DateTime?
  createdAt      DateTime           @default(now())
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userAccount    UserAccount        @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@index([userAccountId, status, createdAt])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          UserAccount?  @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
}

model JobRun {
  id         String    @id @default(cuid())
  jobName    String
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  details    Json?

  @@index([jobName, startedAt])
}

model ReportExport {
  id                       String             @id @default(cuid())
  organizationId           String?
  requestedByUserAccountId String
  name                     String
  status                   ReportExportStatus @default(PENDING)
  parameters               Json
  filePath                 String?
  errorMessage             String?
  createdAt                DateTime           @default(now())
  completedAt              DateTime?
  organization             Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy              UserAccount        @relation(fields: [requestedByUserAccountId], references: [id], onDelete: Restrict)

  @@index([requestedByUserAccountId, createdAt])
  @@index([organizationId, createdAt])
}

model Role {
  id               String                @id @default(cuid())
  organizationId   String
  key              String
  name             String
  description      String?
  isSystem         Boolean               @default(false)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions      RolePermission[]
  assignments      RoleAssignment[]
  positionMappings PositionRoleMapping[]

  @@unique([organizationId, key])
  @@index([organizationId, isActive])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  category    String
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model PositionRoleMapping {
  id         String          @id @default(cuid())
  positionId String
  roleId     String
  scope      PermissionScope
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  position   Position        @relation(fields: [positionId], references: [id], onDelete: Cascade)
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([positionId, roleId, scope])
  @@index([roleId])
}

model RoleAssignment {
  id                     String                 @id @default(cuid())
  membershipId           String
  roleId                 String
  scope                  PermissionScope
  organizationUnitId     String?
  source                 RoleAssignmentSource
  validFrom              DateTime               @default(now())
  validUntil             DateTime?
  grantedByUserAccountId String?
  reason                 String?
  revokedAt              DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  membership             OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role                   Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organizationUnit       OrganizationUnit?      @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  grantedBy              UserAccount?           @relation("RoleAssignmentGrantedBy", fields: [grantedByUserAccountId], references: [id], onDelete: SetNull)

  @@index([membershipId, validFrom, validUntil])
  @@index([roleId])
  @@index([organizationUnitId])
}

model Holiday {
  id             String        @id @default(cuid())
  organizationId String?
  name           String
  date           DateTime
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, date])
}

model CompanySetting {
  organizationId String
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
}

model JobPosting {
  id             String           @id @default(cuid())
  organizationId String?
  title          String
  department     String?
  location       String?
  employmentType String?
  description    String
  status         JobPostingStatus @default(OPEN)
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      UserAccount      @relation("JobPostingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  applications   JobApplication[]
  steps          JobPostingStep[]

  @@index([status, createdAt])
  @@index([createdById])
  @@index([organizationId, status, createdAt])
}

model JobApplication {
  id            String                       @id @default(cuid())
  jobPostingId  String
  fullName      String
  phone         String
  email         String
  cvFileName    String
  cvFileType    String
  cvFileSize    Int
  cvFileData    Bytes
  status        JobApplicationStatus         @default(SUBMITTED)
  createdAt     DateTime                     @default(now())
  jobPosting    JobPosting                   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  stepResponses JobApplicationStepResponse[]

  @@index([jobPostingId, createdAt])
}

enum JobApplicationStatus {
  SUBMITTED
  REVIEWED
  SHORTLISTED
  REJECTED
  HIRED
}

enum JobStepType {
  EMAIL_CV
  QUESTIONNAIRE
  INTERVIEW
}

enum InterviewMode {
  ONLINE
  PHYSICAL
}

model Announcement {
  id             String        @id @default(cuid())
  organizationId String?
  title          String
  content        String
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      UserAccount   @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([createdById])
  @@index([organizationId, createdAt])
}

model JobPostingStep {
  id           String      @id @default(cuid())
  jobPostingId String
  type         JobStepType
  order        Int
  config       Json?

  // Interview-specific fields (only set when type = INTERVIEW)
  interviewMode     InterviewMode?
  interviewerId     String?
  location          String?
  availabilityStart DateTime?
  availabilityEnd   DateTime?
  dailyStartTime    String?
  dailyEndTime      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobPosting  JobPosting                   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviewer Employment?                  @relation("InterviewStepInterviewer", fields: [interviewerId], references: [id], onDelete: Restrict)
  responses   JobApplicationStepResponse[]

  @@index([jobPostingId, order])
  @@index([interviewerId])
}

model JobApplicationStepResponse {
  id            String      @id @default(cuid())
  applicationId String
  stepId        String
  type          JobStepType
  answer        Json?

  // Interview-specific fields (only set when type = INTERVIEW)
  interviewerId String?
  scheduledAt   DateTime?

  createdAt DateTime @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  step        JobPostingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([applicationId, stepId])
  @@unique([interviewerId, scheduledAt])
  @@index([stepId, scheduledAt])
}

model LeaveTypeConfig {
  id                  String           @id @default(cuid())
  organizationId      String?
  code                String
  name                String
  description         String?
  accrualFrequency    AccrualFrequency @default(ANNUALLY)
  defaultAllocation   Float            @default(0)
  allowCarryForward   Boolean          @default(false)
  maxCarryForwardDays Float            @default(0)
  isPaid              Boolean          @default(true)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  organization        Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  leaveRequests        LeaveRequest[]
  leaveBalances        LeaveBalance[]

  @@unique([organizationId, code])
}

model LeaveRequest {
  id              String              @id @default(cuid())
  employeeId      String
  leaveTypeId     String
  startDate       DateTime
  endDate         DateTime
  totalDays       Float
  paidDays        Float?              @default(0)
  unpaidDays      Float?              @default(0)
  reason          String
  status          LeaveRequestStatus  @default(PENDING_MANAGER)
  rejectionReason String?
  appliedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  employee        Employment          @relation("LeaveRequestEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType       LeaveTypeConfig     @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approvalSteps   LeaveApprovalStep[]

  @@index([employeeId, createdAt])
  @@index([status, createdAt])
}

model LeaveApprovalStep {
  id                 String         @id @default(cuid())
  leaveRequestId     String
  sequence           Int
  approverEmployeeId String
  approverKind       ApproverKind
  status             ApprovalStatus @default(PENDING)
  comment            String?
  decidedAt          DateTime?
  createdAt          DateTime       @default(now())
  approver           Employment     @relation("LeaveApprovalStepApprover", fields: [approverEmployeeId], references: [id], onDelete: Restrict)
  leaveRequest       LeaveRequest   @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, sequence])
  @@index([approverEmployeeId, status])
}

model LeaveBalance {
  id          String          @id @default(cuid())
  employeeId  String
  year        Int
  leaveTypeId String
  allocated   Float           @default(0)
  accrued     Float           @default(0)
  used        Float           @default(0)
  carriedOver Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  employee    Employment      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType   LeaveTypeConfig @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, leaveTypeId])
  @@index([employeeId, year])
}

model EmployeeNote {
  id         String         @id @default(cuid())
  employeeId String
  authorId   String
  content    String
  visibility NoteVisibility @default(PRIVATE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  employee   Employment     @relation("NoteTargetEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  author     Employment     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([employeeId, visibility])
  @@index([authorId])
}

model PerformanceTemplate {
  id             String                  @id @default(cuid())
  organizationId String?
  title          String
  description    String?
  fields         Json
  startDate      DateTime
  endDate        DateTime
  createdById    String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      UserAccount             @relation("PerformanceTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  evaluations    PerformanceEvaluation[]

  @@index([startDate, endDate])
  @@index([organizationId, startDate, endDate])
}

model PerformanceEvaluation {
  id           String              @id @default(cuid())
  templateId   String
  employeeId   String
  evaluatorId  String
  responses    Json
  overallScore Float?
  comments     String?
  submittedAt  DateTime            @default(now())
  template     PerformanceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  employee     Employment          @relation("PerformanceTargetEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  evaluator    Employment          @relation("PerformanceEvaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@unique([templateId, employeeId, evaluatorId])
  @@index([employeeId])
  @@index([evaluatorId])
}
