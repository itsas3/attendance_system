{
  "name": "@attendance/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clear:dev": "tsx scripts/clear-development.ts",
    "clean": "rm -rf dist coverage src/generated",
    "generate": "prisma generate",
    "lint": "eslint .",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed:dev": "tsx scripts/seed-development.ts",
    "seed:e2e": "tsx scripts/seed-e2e.ts",
    "studio": "prisma studio",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
