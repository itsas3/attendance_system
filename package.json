{
  "name": "workforce-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "db:clear": "pnpm --filter @attendance/db clear:dev",
    "db:generate": "pnpm --filter @attendance/db generate",
    "db:migrate": "pnpm --filter @attendance/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @attendance/db migrate:deploy",
    "db:seed": "pnpm --filter @attendance/db seed:dev",
    "db:studio": "pnpm --filter @attendance/db studio",
    "dev": "turbo run dev --parallel",
    "dev:portal": "pnpm --filter @workforce/portal dev",
    "dev:device-gateway": "pnpm --filter @attendance/device-gateway dev",
    "dev:worker": "pnpm --filter @attendance/worker dev",
    "docker:dev:db:stop": "docker compose -f docker-compose.dev.yml stop postgres",
    "docker:dev:db:up": "docker compose -f docker-compose.dev.yml up -d postgres",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:prod:config": "docker compose -p workforce-prod --env-file .env.prod -f docker-compose.prod.yml config",
    "docs:check": "node scripts/check-docs.mjs",
    "firmware:build": "pio run -d apps/firmware",
    "firmware:clean": "pio run -d apps/firmware -t clean",
    "firmware:intellisense": "pio run -d apps/firmware -t compiledb",
    "firmware:monitor": "pio device monitor -d apps/firmware",
    "firmware:test": "pio test -d apps/firmware -e native",
    "firmware:test:device": "pio test -d apps/firmware -e esp32dev",
    "firmware:upload": "pio run -d apps/firmware -t upload",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "postinstall": "pnpm --filter @attendance/db generate",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:install": "playwright install chromium",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "typecheck": "turbo run typecheck && tsc -p e2e/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
